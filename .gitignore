node_modules/
dist/
*.tsbuildinfo
.DS_Store
*.log

# DuckDB extension binaries, ~8 MB compressed each. Fetched by
# `./run fetch-extensions` and by prepublishOnly, never committed: the set is
# reproducible from extensions.duckdb.org for the pinned DuckDB version, and
# committing it would add that much to the history on every version bump.
extensions/

# Worktrees live at <repo>/.worktrees/<branch>, per the workspace convention.
.worktrees/

# Production dependency staging for ./run deploy-halos, one tree per target
# platform triple. Rebuilt from package.json on every deploy.
.deploy/
